diff --color -ruN a/llvm/lib/Support/WASI/Program.inc b/llvm/lib/Support/WASI/Program.inc
--- a/llvm/lib/Support/WASI/Program.inc
+++ b/llvm/lib/Support/WASI/Program.inc
@@ -0,0 +1,83 @@
+//===- llvm/Support/WASI/Program.inc ----------------------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// WASI (preview 1) has no processes: every function that would start or wait
+// for a program fails. (Local addition for the wuica assembler build; not part
+// of upstream LLVM 22.)
+//
+//===----------------------------------------------------------------------===//
+
+#include "llvm/Support/Errc.h"
+#include "llvm/Support/Program.h"
+#include "llvm/Support/raw_ostream.h"
+
+namespace llvm {
+
+using namespace sys;
+
+ProcessInfo::ProcessInfo() : Pid(0), ReturnCode(0) {}
+
+ErrorOr<std::string> sys::findProgramByName(StringRef Name,
+                                            ArrayRef<StringRef> Paths) {
+  return errc::no_such_file_or_directory;
+}
+
+static bool Execute(ProcessInfo &PI, StringRef Program,
+                    ArrayRef<StringRef> Args,
+                    std::optional<ArrayRef<StringRef>> Env,
+                    ArrayRef<std::optional<StringRef>> Redirects,
+                    unsigned MemoryLimit, std::string *ErrMsg,
+                    BitVector *AffinityMask, bool DetachProcess) {
+  if (ErrMsg)
+    *ErrMsg = "cannot execute programs on WASI";
+  return false;
+}
+
+ProcessInfo sys::Wait(const ProcessInfo &PI,
+                      std::optional<unsigned> SecondsToWait,
+                      std::string *ErrMsg,
+                      std::optional<ProcessStatistics> *ProcStat,
+                      bool Polling) {
+  if (ErrMsg)
+    *ErrMsg = "cannot wait for programs on WASI";
+  ProcessInfo WaitResult;
+  WaitResult.ReturnCode = -1;
+  return WaitResult;
+}
+
+std::error_code sys::ChangeStdinMode(fs::OpenFlags Flags) {
+  return std::error_code();
+}
+
+std::error_code sys::ChangeStdoutMode(fs::OpenFlags Flags) {
+  return std::error_code();
+}
+
+std::error_code sys::ChangeStdinToBinary() { return std::error_code(); }
+
+std::error_code sys::ChangeStdoutToBinary() { return std::error_code(); }
+
+std::error_code
+sys::writeFileWithEncoding(StringRef FileName, StringRef Contents,
+                           WindowsEncodingMethod Encoding /*unused*/) {
+  std::error_code EC;
+  raw_fd_ostream OS(FileName, EC, sys::fs::OpenFlags::OF_TextWithCRLF);
+  if (EC)
+    return EC;
+  OS << Contents;
+  if (OS.has_error())
+    return make_error_code(errc::io_error);
+  return EC;
+}
+
+bool sys::commandLineFitsWithinSystemLimits(StringRef Program,
+                                            ArrayRef<StringRef> Args) {
+  return true;
+}
+
+} // namespace llvm
