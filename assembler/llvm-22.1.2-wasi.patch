+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// WASI (preview 1) has no signals and no stack unwinding: handlers are never
+// installed and no stack trace is printed. (Local addition for the wuica
+// assembler build; not part of upstream LLVM 22.)
+//
+//===----------------------------------------------------------------------===//
+
+#include "llvm/Support/Signals.h"
+
+using namespace llvm;
