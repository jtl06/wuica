# /etc/systemd/system/wuica-api.service: the wuica API and MCP server (server/), behind a Cloudflare tunnel.
# It listens on 127.0.0.1:8787 only; cloudflared (cloudflared.yml) connects out to Cloudflare, so no inbound port is open.
[Unit]
Description=wuica API and remote MCP server (x86-64 basic-block throughput prediction)
Documentation=https://wuica.jacen.li
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wuica
Group=wuica
WorkingDirectory=/opt/wuica/server
ExecStart=/opt/node/bin/node bin/wuica-server.js
Environment=NODE_ENV=production
Environment=WUICA_HOST=127.0.0.1
Environment=WUICA_PORT=8787
Environment=WUICA_WORKERS=2
# per-request limits and the rate limit (defaults in server/lib/config.js)
Environment=WUICA_TIMEOUT_MS=10000
Environment=WUICA_MAX_QUEUE=64
Environment=WUICA_RATE_BURST=60
Environment=WUICA_RATE_PER_MINUTE=120
# memory per worker: the analyzer's WebAssembly memory is capped at this (an input that needs more gets code 3)
Environment=WUICA_ANALYZER_MEMORY_MB=2048
Restart=always
RestartSec=2
# SIGTERM: the server stops accepting, finishes running requests (up to 15 s) and exits
KillSignal=SIGTERM
TimeoutStopSec=25

# Memory: 2 workers x (one analyzer instance <= 2 GiB + assembler <= 256 MiB + instruction counter <= ~0.1 GiB +
# ~0.2 GiB for V8 and the tables) + ~0.2 GiB for the main thread = ~5.3 GiB at most. The analyzer cap keeps one input
# from taking more, and a worker frees a trapped instance (forced GC) before it creates the next one. Measured on the
# Mac: one worker, a compare that hits the 2 GiB cap on all 15 models: 1.8 GB peak RSS for the whole process. 12 GB VM.
MemoryHigh=6G
MemoryMax=7G
MemorySwapMax=0
TasksMax=128
LimitNOFILE=65536

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# a filtered system call fails with EPERM instead of killing the process
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# only cloudflared (on this host) talks to the server; the server itself needs no network
IPAddressAllow=localhost
IPAddressDeny=any
# MemoryDenyWriteExecute must stay off: V8 compiles JavaScript and WebAssembly to machine code at run time.

[Install]
WantedBy=multi-user.target
