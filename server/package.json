{
  "name": "wuica-server",
  "version": "0.1.0",
  "private": true,
  "description": "The public HTTP API and remote MCP server of wuica (x86-64 basic-block throughput prediction, uiCA in WebAssembly)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./lib/app.js",
  "bin": {
    "wuica-server": "bin/wuica-server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/wuica-server.js",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "bench": "node bench/load.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "wuica": "file:../packages/wuica",
    "zod": "4.6.7"
  }
}
