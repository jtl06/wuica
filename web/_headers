# Cloudflare Pages response headers. The page may be indexed; the tables and the license texts are not pages.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://godbolt.org; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
/data/*
  X-Robots-Tag: noindex
# the tables are gzip files the page decompresses itself (.bin.gz: application/gzip, which the host does not compress):
# no Content-Encoding, and no transformation on the way
/data/arch/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/licenses/*
  X-Robots-Tag: noindex
/sw.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
